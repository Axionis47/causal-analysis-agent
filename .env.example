# =============================================================================
# Causal Analysis Agent - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values

# =============================================================================
# Application Settings
# =============================================================================
ENVIRONMENT=development
DEBUG=true

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_STRUCTURED_LOGGING=true

# =============================================================================
# Sentry
# =============================================================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/causal_analysis
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# PostgreSQL (for Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=causal_analysis

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# =============================================================================
# Security
# =============================================================================
# IMPORTANT: Change this in production!
SECRET_KEY=change-this-to-a-secure-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256
CREDENTIALS_ENCRYPTION_KEY=change-this-32-byte-key

# =============================================================================
# CORS Settings
# =============================================================================
CORS_ORIGINS=["http://localhost:3000"]

# =============================================================================
# LLM Provider Configuration
# =============================================================================

# Google Vertex AI (Primary)
VERTEX_AI_PROJECT=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1

# OpenAI (Fallback)
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic (Alternative)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# LLM Routing
LLM_PRIMARY_PROVIDER=vertex
LLM_FALLBACK_PROVIDERS=["openai","anthropic"]
LLM_CIRCUIT_BREAKER_THRESHOLD=5
LLM_CIRCUIT_BREAKER_TIMEOUT_SECONDS=300
LLM_RETRY_MAX_ATTEMPTS=4
LLM_RETRY_BACKOFF_SECONDS=1.0

# LLM Caching
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=3600
LLM_CACHE_MAX_PROMPT_LENGTH=10000

# Cost-based Routing
LLM_COST_BASED_ROUTING_ENABLED=true
LLM_SIMPLE_PROMPT_MAX_LENGTH=500

# =============================================================================
# LangSmith Configuration (Observability)
# =============================================================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls-your-langsmith-api-key
LANGCHAIN_PROJECT=causal-analysis

# =============================================================================
# Google Cloud Storage
# =============================================================================
GCS_BUCKET_NAME=causal-analysis-datasets
GCS_REPORTS_BUCKET_NAME=causal-analysis-reports
LOCAL_STORAGE_PATH=./storage
# Set GOOGLE_APPLICATION_CREDENTIALS environment variable to your service account key path
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# =============================================================================
# Kaggle API
# =============================================================================
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key

# =============================================================================
# Tool Feature Flags
# =============================================================================
ENABLE_BETA_TOOLS=false
ENABLE_ALPHA_TOOLS=false
ENABLE_GES=false
ENABLE_FCI=false
ENABLE_DOUBLY_ROBUST=false
ENABLE_IV=false
TOOL_CONFIG_PATH=./config/tools.yaml
# Path is resolved relative to backend working directory.

# =============================================================================
# Frontend Configuration
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
